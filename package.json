{
  "name": "three-kingdoms-local",
  "version": "0.83.0",
  "description": "English edition of a self-hosted multiplayer Three Kingdoms card game",
  "type": "module",
  "scripts": {
    "start": "node server.mjs",
    "test": "node --test",
    "dev": "PORT=4173 node server.mjs",
    "start:llm": "node --env-file=.env.local server.mjs",
    "llm:check": "node --env-file=.env.local scripts/llm-check.mjs",
    "logs:key": "node scripts/archive-key.mjs",
    "llm:bench": "node --env-file-if-exists=.env.local scripts/llm-bench.mjs",
    "llm:investigate-rescue": "node --env-file-if-exists=.env.local scripts/investigate-rescue.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT"
}
