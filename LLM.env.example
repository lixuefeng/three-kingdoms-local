# Copy this file to .env.local; never share .env.local.
# The endpoint must expose POST <base>/chat/completions.
LLM_BASE_URL=http://127.0.0.1:1234/v1
LLM_MODEL=replace-with-your-loaded-model-id
LLM_API_KEY=
LLM_TIMEOUT_MS=10000
LLM_MAX_TOKENS=1500
# Use max_tokens if your local server does not support max_completion_tokens.
LLM_TOKEN_FIELD=max_completion_tokens
# Set off for servers that reject response_format; JSON is still required.
LLM_JSON_MODE=on
LLM_MAX_REQUESTS_PER_MATCH=300
# Preserve your existing tunnel origin here if needed:
# PUBLIC_ORIGIN=https://your-tunnel.example

# Bedrock users: the existing bedrock-runtime ... /openai/v1 base and token
# automatically enable Kimi, Claude and DeepSeek selectors.
# Optional overrides (Claude uses the native runtime ROOT, not /openai/v1):
# BEDROCK_BASE_URL=https://bedrock-runtime.us-east-1.amazonaws.com
# AWS_BEARER_TOKEN_BEDROCK=your-short-term-token
# LLM_KIMI_MODEL=moonshotai.kimi-k2.5
# LLM_CLAUDE_MODEL=us.anthropic.claude-haiku-5-5
# LLM_DEEPSEEK_MODEL=deepseek.v3.2
# Enable only in testing: host can inspect bot private hands/roles and outputs.
LLM_DEBUG=0
HOST=127.0.0.1
# Separate conversational reply budget per bot per match (also per lobby).
LLM_CHAT_MAX_REQUESTS=60

# Claude has a separate combined reasoning + answer budget.
LLM_CLAUDE_MAX_TOKENS=8192
LLM_CLAUDE_TIMEOUT_MS=20000
LLM_CLAUDE_EFFORT=medium
